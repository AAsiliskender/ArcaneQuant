 # Python cache
__pycache__/
*.py[cod]

# Environments
APIkey.env
SQLlogin.env
.venv/
*.egg-info/

# Databases or notebooks
*.db
*.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# Data
data/*
data/StockHistData/**

# EXCEPTION FOR IGNORE
# When ignoring a folder but exception inside, you must except all folders on the way there (so each folder is searched)
!data/
!data/StockHistData/
!data/StockHistData/dataManifest.json
!data/StockHistData/MSFT/
!data/StockHistData/NVDA/
!data/StockHistData/MSFT/MSFT*2022-01*.csv
!data/StockHistData/NVDA/NVDA*2022-01*.csv
# Changed this to make it only not ignore a single month (with all intervals) (as sample data)
